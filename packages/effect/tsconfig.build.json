{
    "compilerOptions": {
        "target": "ES2022",
        "lib": ["dom", "esnext"],
        "module": "nodenext",
        "moduleResolution": "nodenext",
        "strict": true,
        "skipLibCheck": true,
        "declaration": true,
        "outDir": "dist",
        "rootDir": "src",
        "rewriteRelativeImportExtensions": true,
        "types": []
    },
    "include": ["src"]
}
